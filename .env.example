# Verifin environment variables (names only; never put real keys in this file).
#
# Real values go in:
#   - .env.local            -> only for local scripts (scripts/spike/*), never committed
#   - Convex dashboard      -> for the deployed backend (Settings > Environment Variables)

# --- Required ---------------------------------------------------------------
GEMINI_API_KEY=            # Google AI Studio: reads questions and claims, extraction, verification judge, writing
SEC_USER_AGENT=            # your name and email, e.g. "Asha Rao asha@example.com" (the SEC asks every program to identify itself)
CONTACT_USER_AGENT=        # same idea for Wikimedia (news photos). If empty, SEC_USER_AGENT is used. A real contact avoids "too many requests" limits
FINNHUB_API_KEY=           # finnhub.io: financial news + market data
RESEND_API_KEY=            # resend.com: Watch email alerts and daily digest

# --- Optional ---------------------------------------------------------------
FMP_API_KEY=               # Financial Modeling Prep: statements and ratios
FIRECRAWL_API_KEY=         # Firecrawl: clean text from web pages
GOOGLE_CLIENT_ID=          # Google sign-in
GOOGLE_CLIENT_SECRET=      # Google sign-in
SENTRY_DSN=                # error tracking

# --- Convex -----------------------------------------------------------------
CONVEX_DEPLOYMENT=         # filled in automatically by `npx convex dev`
PUBLIC_CONVEX_URL=         # filled in automatically by `npx convex dev`

# --- App settings (backend) -------------------------------------------------
SITE_URL=http://localhost:5173
ADMIN_EMAILS=              # comma-separated emails that get the admin role

# --- Stock data (free plans; Indian stock coverage is being tested) ---------
TWELVEDATA_API_KEY=        # twelvedata.com: prices (free: 800 calls/day, 8/min)
ALPHAVANTAGE_API_KEY=     # alphavantage.co: prices and company data (free: 25 calls/day)
